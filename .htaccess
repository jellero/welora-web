# Welora — indirizzi puliti (senza .html) su Apache/Aruba
Options -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# welora.it -> https://www.welora.it (dominio principale con www)
RewriteCond %{HTTP_HOST} ^welora\.it$ [NC]
RewriteRule ^ https://www.welora.it%{REQUEST_URI} [R=301,L]

# /index.html -> /  (redirect permanente)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://www.welora.it/%1 [R=301,L]

# /pagina.html -> /pagina  (redirect permanente, i vecchi link continuano a funzionare)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ https://www.welora.it/%1 [R=301,L]

# /pagina -> serve pagina.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
